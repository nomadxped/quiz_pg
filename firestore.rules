rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Questions collection
    match /questions/{questionId} {
      // Publicly readable for students fetching the quiz
      allow read: if true;
      
      // ONLY the specific Admin user can create, update, or delete questions.
      // Replace REPLACE_WITH_YOUR_ADMIN_UID with your actual UID from Firebase Console.
      allow write: if request.auth != null && request.auth.uid == 'JaWP7oxTMpUHumNv7cWAALYal5l2';
    }
    
    // Messages collection for Chat & Help
    match /messages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['studentName', 'text', 'timestamp'])
                    && request.resource.data.studentName is string
                    && request.resource.data.text is string
                    && request.resource.data.timestamp is timestamp
                    && request.resource.data.studentName.size() > 0
                    && request.resource.data.studentName.size() <= 50
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500;
      allow update, delete: if false;
    }
  }
}
